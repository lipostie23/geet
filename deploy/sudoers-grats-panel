# Положите этот файл в /etc/sudoers.d/grats-panel и проверьте через `visudo -c`.
# Разрешает пользователю www-data выполнять только нужные команды от имени omp,
# и БЕЗ ПАРОЛЯ — что обязательно, иначе sudo заблокирует выполнение из веба.
#
# Активируется только если в config.php прописан 'run_as_user' => 'omp'.

www-data ALL=(omp) NOPASSWD: /usr/bin/bash -c *
